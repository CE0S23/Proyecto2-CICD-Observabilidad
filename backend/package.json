{
  "name": "proyecto2-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API NestJS + Prisma + PostgreSQL con JWT y OpenTelemetry - Proyecto Parcial 2",
  "author": "César Osvaldo Ramírez Pérez",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node -r ./dist/src/tracing.js dist/src/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:api": "jest --config jest.config.js --selectProjects api --runInBand",
    "test:ci": "jest --config jest.config.js --runInBand --ci",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "node dist/prisma/seed.js",
    "seed:dev": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.22",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.57.2",
    "@opentelemetry/auto-instrumentations-node": "0.56.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.57.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-logs": "0.57.2",
    "@opentelemetry/sdk-metrics": "1.30.1",
    "@opentelemetry/sdk-node": "0.57.2",
    "@opentelemetry/semantic-conventions": "1.30.0",
    "@prisma/client": "6.19.3",
    "@prisma/instrumentation": "6.19.3",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "pino": "9.6.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
