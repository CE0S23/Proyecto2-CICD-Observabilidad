# Copia este archivo a .env y reemplaza los valores. .env NUNCA se sube al repositorio.
# --- PostgreSQL (contenedor db) ---
POSTGRES_USER=proyecto2
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=proyecto2

# --- Backend (contenedor app) ---
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h
SEED_ADMIN_EMAIL=admin@proyecto2.com
SEED_ADMIN_PASSWORD=cambia-esta-contrasena
APP_ENV=production
# true para no exportar telemetria (por ejemplo en CI sin collector)
OTEL_SDK_DISABLED=false

# --- OpenObserve (contenedor observability) ---
O2_USER=admin@proyecto2.com
O2_PASSWORD=cambia-esta-contrasena
HOST_LABEL=ec2-proyecto2

# Lo inyecta el pipeline en cada deploy
GIT_COMMIT=local
